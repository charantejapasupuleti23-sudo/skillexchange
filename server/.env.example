# Server Environment Configuration

# Server Port and Environment
PORT=5001
NODE_ENV=production

# MongoDB Connection String (e.g. MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/skillloop?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRE=30d
COOKIE_EXPIRE=30

# Frontend URL for CORS and Email Links (Your Vercel URL)
CLIENT_URL=https://your-frontend-app.vercel.app

# Cloudinary (Optional, for image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Settings (Optional, for password resets)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@skillloop.dev
EMAIL_FROM_NAME=SkillLoop
